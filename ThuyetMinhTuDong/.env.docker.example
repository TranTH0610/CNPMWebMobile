DOCKER_SQL_PORT=14330
DOCKER_VISITOR_PORT=18080
DOCKER_ADMIN_PORT=18081
DOCKER_CATALOG_PORT=18888
DOCKER_PRESENCE_PORT=18887
DOCKER_VISITOR_BIND=0.0.0.0
