# Cấu hình riêng của API; không thêm tiền tố VITE_ hoặc EXPO_PUBLIC_.
SQL_SERVER=localhost
SQL_DATABASE=HueGuideDemo
SQL_AUTH=windows
SQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server
SQL_ENCRYPT=false
SQL_TRUST_CERT=true
# Nếu dùng SQL Authentication, đổi SQL_AUTH=sql và khai báo:
# SQL_USER=hueguide_app
# SQL_PASSWORD=mat_khau_rieng_cua_ban
