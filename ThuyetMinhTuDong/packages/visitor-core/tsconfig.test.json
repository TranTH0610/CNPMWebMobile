  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": ".test-build",
    "skipLibCheck": true,
    "types": [],
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "src/domain/model.ts",
    "src/catalog/catalog.ts",
    "src/links/qr.ts",
    "src/data/mock.ts",
    "src/i18n/messages.ts",
