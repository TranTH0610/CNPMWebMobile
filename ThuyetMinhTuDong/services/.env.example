# FILE NÀY LÀM GÌ: Mẫu cấu hình riêng cho API/SQL, không dùng trong FE.
# Sao chép thành services/.env.local; không commit file thật.
# Biến môi trường đã đặt trên máy/chỗ triển khai được ưu tiên hơn file này.
SQL_SERVER=localhost
SQL_DATABASE=HueGuideDemo
SQL_AUTH=windows
SQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# Chỉ dùng false/true bên dưới cho SQL cục bộ phát triển.
# Triển khai thật: bật TLS, xác minh chứng thư hợp lệ của SQL Server.
SQL_ENCRYPT=false
SQL_TRUST_CERT=true
# Chỉ điền khi SQL_AUTH=sql; không sử dụng tài khoản sa.
SQL_USER=
SQL_PASSWORD=
