# FILE NÀY LÀM GÌ: Mẫu duy nhất cho cấu hình CÔNG KHAI của mobile.
# Sao chép thành apps/mobile/.env.local; Expo tự đọc file tại thư mục app.
# Script start/start:admin tự cấp URL proxy đúng Wi-Fi cho phiên chạy.
# Chỉ điền các URL bên dưới nếu có nhu cầu cấu hình riêng.
# EXPO_PUBLIC_* có trong app: không đặt mật khẩu hoặc token quản trị.
EXPO_PUBLIC_CATALOG_API_URL=
EXPO_PUBLIC_ADMIN_API_URL=
EXPO_PUBLIC_PRESENCE_API_URL=
EXPO_PUBLIC_ADMIN_PRESENCE_API_URL=
EXPO_PUBLIC_VISITOR_WEB_ORIGIN=

# Định danh ứng dụng công khai, dùng khi build app cài riêng.
ANDROID_APPLICATION_ID=
IOS_BUNDLE_IDENTIFIER=
# Khóa bản đồ phía ứng dụng là công khai; giới hạn theo app tại nhà cung cấp.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
