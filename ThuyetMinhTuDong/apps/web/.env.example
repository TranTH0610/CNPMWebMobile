# FILE NÀY LÀM GÌ: Mẫu duy nhất cho cấu hình CÔNG KHAI của web.
# Sao chép thành apps/web/.env.local khi cần đổi giá trị mặc định.
# VITE_* có thể xuất hiện trong JavaScript gửi tới trình duyệt.
# Không đặt mật khẩu SQL, token quản trị hoặc khóa riêng ở đây.

# Để trống dùng proxy cùng origin đã cấu hình trong Vite/reverse proxy.
VITE_CATALOG_API_URL=
VITE_ADMIN_API_URL=
VITE_PRESENCE_API_URL=
# Website HTTPS cho QR; script QR có thể tự cập nhật giá trị này.
VITE_PUBLIC_SITE_URL=

# Thông tin công khai xác minh liên kết app; không phải khóa ký ứng dụng.
# links:generate đọc process.env: cần đặt các biến này trong terminal/CI
# khi chạy lệnh đó, không mặc định coi script Node tự đọc file của Vite.
ANDROID_APPLICATION_ID=
ANDROID_SHA256_CERT_FINGERPRINTS=
IOS_BUNDLE_IDENTIFIER=
APPLE_TEAM_ID=
