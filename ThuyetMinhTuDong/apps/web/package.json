{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/start-web.cjs",
    "prebuild": "node ../../scripts/generate-app-links.cjs --if-configured",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "dev:admin": "node ../../scripts/start-web.cjs --admin",
    "build:admin": "vite build --mode admin",
    "preview:admin": "vite preview --mode admin --host 127.0.0.1 --port 4174 --strictPort"
  },
  "dependencies": {
    "@travelguide/place-core": "*",
    "@travelguide/shared-types": "*",
    "@travelguide/visitor-core": "^0.1.0",
    "i18next": "^26.4.2",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^6.22.0",
    "@travelguide/admin-core": "*"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vite": "^5.1.0"
  }
}
